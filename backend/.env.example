DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set DATABASE_URL in production to use PostgreSQL (for example, Supabase).
# It takes precedence over the MySQL settings below.
DATABASE_URL=
# Set this in production to persist uploaded vehicle images in Cloudinary.
# Leave unset to use local filesystem storage during development.
CLOUDINARY_URL=
MYSQL_DATABASE=fantics_motors
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60